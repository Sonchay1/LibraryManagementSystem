@model IEnumerable<LibraryManagementSystem.Models.Author>

<h2>Authors</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Author</a>

<table class="table table-bordered">
    <thead>
        <tr><th>Name</th><th>Bio</th><th>Total Books</th><th>Action</th></tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.Name</td>
                <td>@author.Bio</td>
                <td>@author.Books.Count</td>
                <td><a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-sm btn-danger">Delete</a></td>
            </tr>
        }
    </tbody>
</table>