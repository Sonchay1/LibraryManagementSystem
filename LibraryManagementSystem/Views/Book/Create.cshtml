@model LibraryManagementSystem.Models.Book

<h2>Add Book</h2>
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ISBN" class="form-label"></label>
        <input asp-for="ISBN" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PublishedYear" class="form-label"></label>
        <input asp-for="PublishedYear" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="TotalCopies" class="form-label"></label>
        <input asp-for="TotalCopies" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Author</label>
        <select name="AuthorId" class="form-control" asp-items="ViewBag.Authors"></select>
    </div>

    <div class="mb-3">
        <label>Categories</label><br />
        @foreach (var cat in (List<LibraryManagementSystem.Models.Category>)ViewBag.Categories)
        {
            <label class="me-3">
                <input type="checkbox" name="selectedCategories" value="@cat.Id" /> @cat.Name
            </label>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>