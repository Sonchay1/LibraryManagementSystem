@model IEnumerable<LibraryManagementSystem.Models.Book>

<h2>Books</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Book</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Categories</th>
            <th>Available/Total</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@book.Id">@book.Title</a></td>
                <td>@book.Author?.Name</td>
                <td>@string.Join(", ", book.Categories.Select(c => c.Name))</td>
                <td>@book.AvailableCopies / @book.TotalCopies</td>
                <td>
                    <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>