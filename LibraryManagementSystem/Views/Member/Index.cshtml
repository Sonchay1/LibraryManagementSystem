@model IEnumerable<LibraryManagementSystem.Models.Member>

<h2>Members</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Member</a>

<table class="table table-bordered">
    <thead>
        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Join Date</th></tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>@member.Name</td>
                <td>@member.Email</td>
                <td>@member.Phone</td>
                <td>@member.JoinDate.ToString("dd MMM yyyy")</td>
            </tr>
        }
    </tbody>
</table>